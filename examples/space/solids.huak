import space as s
import space.silhouette
import paint.*
import transform.compose

axis := compose(translate((0,0,-28mm)), rotate(58deg, axis:(0,1,0)))
tube := transformed(s.cylinder(9mm,56mm), axis)
ball := transformed(s.sphere(18mm), translate((3mm,4mm,0)))
view := s.project([tube,ball], s.orthographic(-65deg,26deg))
inks := [rgb(0.13,0.50,0.58,0.45), rgb(0.95,0.56,0.16,0.45)]
contour := pen(rgb(0.12,0.17,0.19),0.85pt)
ridge := pen(rgb(0.12,0.17,0.19),0.4pt)
cut := pen(rgb(0.49,0.08,0.25),1.1pt)
behind := pen(rgb(0.49,0.08,0.25),0.7pt,dash:[2pt,1pt])

default drawing picture() do
    for layer in view.layers do
        for face in layer.faces do +face.region filled inks[face.source] end
        for line in layer.lines do
            if line.kind == "intersection" then
                if line.visible then +draw line.curve with cut else +draw line.curve with behind end
            else if line.kind == "outline" then
                +draw line.curve with contour
            else if line.kind == "edge" then
                +draw line.curve with ridge
            end end end
        end
    end
    +draw view.silhouette() with contour
end
