import drawing.drawing
import paint.{rgb, pen, translate, scale, rotate, path, transformed, draw, fill, label, picture}
import pen.{pencircle, pensquare, makepen, stroke_outline}
param nib_width:length = 3mm
param nib_angle:angle = 30deg

export plate := picture(12cm, 8cm)
default plate
drawing plate do
    blue := rgb(0.1, 0.3, 0.8)
    curve := (1cm, 1cm)~~(3cm, 3cm)~~(5cm, 1cm)
    ordinary := pen(blue, 0.6mm, "round", "bevel", 8, [3mm, 1mm], 0.5mm)
    +draw(curve, ordinary)
    ellipse := pencircle(nib_width, blue).transformed(scale(1, 0.2)).transformed(rotate(nib_angle))
    +draw(curve, ellipse, translate((0, 3cm)))
    square := pensquare(2mm, rgb(0.8, 0.1, 0.2))
    outline := stroke_outline(path((7cm, 1cm), (10cm, 3cm)), square, 0.01mm)
    +fill(outline, rgb(0.8, 0.1, 0.2))
    polygon := makepen((-1mm, -1mm)--(1mm, -1mm)--(0, 2mm)--cycle, blue)
    +draw(path((7cm, 4cm), (10cm, 6cm)), polygon)
    caption := typ[
Native units and pens $x^2$ Ω
]
    +label(caption, (5mm, 7cm))
end
