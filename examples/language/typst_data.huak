import paint.*

param title = "Typed data Ω"
param count: int = 42
font_size := 14pt
ink := rgb(0.15, 0.35, 0.7)

// The module snapshots the size and ink its code reads when it is made.
theme := typ.module[
  #let style(body) = {
    set text(size: huak.font_size, fill: huak.ink)
    body
  }
]
typ.show theme.style

export plate := picture with width 110mm height 50mm
default plate

drawing plate do
    +typ[#huak.title: #huak.count] at (8mm, 32mm)
    +draw (8mm, 20mm)--(100mm, 20mm)
end
