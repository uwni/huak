import paint.{rgb, pen, bounds, draw, label, picture}
import assertions.assert
import "transforms.huak" as transforms

base := (0, 0) ~~ (20, 35) ~~ (45, 10) ~~ (65, 40)
curve := base transforms.scaled 2 transforms.shifted (30, 30)
ordinary := transforms.shifted(transforms.scaled(base, 2), (30, 30))
assert(curve.bounds() == ordinary.bounds())

export pic := picture(240, 180)
default pic
object.append(pic, object.draw(curve, pen(rgb(0.15, 0.35, 0.7), 2)))

caption := typ[
    Infix geometry $x^2 + y^2$ Ω
]
object.append(pic, object.label(caption, (25, 150)))
