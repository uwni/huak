import paint.{translate, scale, transformed}
precedence transform
    below addition
    above path
    associativity left
end
export transform

fn scaled(value: path, factor: float) -> path
    return transformed(value, scale(factor))
end
mixfix(scaled) _ scaled _ in transform
export scaled

fn shifted(value: path, offset: vec2) -> path
    return transformed(value, translate(offset))
end
mixfix(shifted) _ shifted _ in transform
export shifted
