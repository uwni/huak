import drawing.drawing
import paint.{draw, fill}
import paint.{circle, label, picture}
import "lib/brushes.huak" as brushes

export sketch := picture(240, 140)
export detail := picture(80, 80)
default sketch

curve := (20, 30) ~~ (80, 100) ~~ (150, 40)
disc := circle((40, 40), 18)
drawing sketch do
    +draw curve
    +draw brushes.reversed curve
    +drawing detail do
        +fill disc
    end
    +brushes.painted circle((185, 80), 18)
end

caption := typ[
    Prefix drawing $x^2$ Ω
]
object.append(sketch, object.label(caption, (15, 125)))
