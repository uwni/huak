import paint.{rgb, reverse, fill}
precedence brush_command
    below path
    above logical_or
end
export brush_command

fn painted(curve: path) -> object
    return fill(curve, rgb(0.15, 0.4, 0.8))
end
mixfix painted _ in brush_command
export painted

fn reversed(curve: path) -> path
    return reverse(curve)
end
mixfix reversed _ in unary
export reversed
