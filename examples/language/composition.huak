// Cut once with a compound hole, then append any foreground objects.
// Each isolated export has a transparent background. PDF keeps native text.
import paint.*
import geometry.compound

theme := typ.module[#let style(body) = { set text(size: 10pt); body }]
typ.show theme.style
caption := typ[$V = I R$]
caption_position := (15mm, 37mm)
padding := 2mm
symbol_center := (58mm, 24mm)
wire_pen := pen(rgb(0.12, 0.4, 0.75, 0.75), 0.7mm)

source := picture with width 80mm height 70mm
drawing source do
    for y in 10mm:10mm:60mm do
        +draw ((5mm, y) -- (75mm, y)) with wire_pen
    end
    for x in 10mm:10mm:70mm do
        +draw ((x, 5mm) -- (x, 65mm)) with wire_pen
    end
    +typ[Native text stays selectable in PDF] at (3mm, 68mm)
end

text_hole := rectangle(
    (caption_position.x - padding, caption_position.y + caption.baseline - caption.height - padding),
    caption.width + 2 * padding,
    caption.height + 2 * padding
)
symbol_hole := circle with center symbol_center radius 10mm
holes := compound([text_hole, symbol_hole])
export clipped := picture with width 80mm height 70mm
drawing clipped do
    +source cut holes
end

foreground := picture with width 80mm height 70mm
drawing foreground do
    +caption at caption_position
    +(circle with center symbol_center radius 7mm) filled rgb(0.8, 0.18, 0.12, 0.7)
    +draw ((52mm, 24mm) -- (64mm, 24mm)) with pen(rgb(0.2, 0.05, 0.02), 0.4mm)
    +draw ((58mm, 18mm) -- (58mm, 30mm)) with pen(rgb(0.2, 0.05, 0.02), 0.4mm)
end

export before := picture with width 80mm height 70mm
drawing before do
    +copy(source)
    +copy(foreground)
end
export after := picture with width 80mm height 70mm
drawing after do
    +copy(clipped)
    +copy(foreground)
end
export source, foreground

// The gold checkerboard is separate from the transparent compositions.
export plate := picture with width 180mm height 95mm
default plate
drawing plate do
    +(rectangle with origin (0mm, 0mm) width 180mm height 95mm) filled rgb(0.97, 0.9, 0.64)
    for row in 0:6 do
        for column in 0:7 do
            if (row + column) % 2 == 0 then
                tile := rectangle((column * 10mm, row * 10mm), 10mm, 10mm)
                +transformed(tile, translate((5mm, 5mm))) filled rgb(0.85, 0.72, 0.38)
                +transformed(tile, translate((95mm, 5mm))) filled rgb(0.85, 0.72, 0.38)
            end
        end
    end
    +before shifted (5mm, 5mm)
    +after shifted (95mm, 5mm)
    +typ[Before] at (8mm, 85mm)
    +typ[One transparent cut, mixed foreground] at (98mm, 85mm)
end
