import paint.{rgb, pen, circle, draw}
# Internal geometry choices stay private to this module.
radius := 8
ink := pen(rgb(0.12, 0.32, 0.65), 1.5)

fn marker(center: vec2) -> object
    return draw(circle(center, radius), ink)
end
export marker

setup_typst {
    set text(size: 14pt)
}
export caption := typ[
    Imported geometry $x^2 + y^2$ Ω
]
