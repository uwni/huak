import drawing.drawing
import std.math.{PI as pi, sin}
import std.paint.{circle as disk, filled, at, append}
import std.assertions.assert
import color.rgb

assert(sin(pi / 2) == 1)
blue := rgb(0.1, 0.4, 0.8)
export plate := picture(80mm, 50mm)
default plate
drawing plate do
    +circle with center (40mm, 24mm) radius 15mm filled blue
    +typ[Standard library namespaces] at (7mm, 44mm)
end
