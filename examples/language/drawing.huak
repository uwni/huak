import drawing.drawing
import math.{sin, abs}
import solver.{unknown, equation, solve, value}
import paint.{rgb, pen, circle, path, draw, fill, label, picture}
import assertions.assert
param count: int = 7
param title: string = "Native drawing"
assert(count > 0, "count must be positive")

theme := typ.module[
  #let style(body) = {
    set text(font: "New Computer Modern", size: 15pt, fill: rgb("263454"))
    body
  }
  #let caption(body) = strong(body)
]
typ.show theme.style

fn wave(x: float) -> float
    return 95 + 35 * sin(x / 32)
end

fn marker(at: vec2, color: color) -> object
    return fill(circle(at, 3), color)
end

export pic := picture(360, 220)
default pic
blue := rgb(0.16, 0.38, 0.75)
ink := pen(blue, 1.6)
curve := (30, wave(30)) ~~ (105, wave(105)) ~~ (180, wave(180)) ~~ (255, wave(255)) ~~ (330, wave(330))
heading := typ[
  #huak.theme.caption(sys.inputs.title) $ integral_0^1 x^2 dif x = 1/3 $
]
drawing pic do
    +draw(path((25, 45), (335, 45)), pen(rgb(0.5, 0.5, 0.5)))
    for i in 0:count do
        x := 30 + i * 300 / count
        +marker((x, x.wave()), blue)
    end
    +draw(curve, ink)
    +label(heading, (30, 185))
end

s := solver()
u := unknown(s); v := unknown(s)
equation(s, 2 * u + v, 8)
equation(s, u - v, 1)
answer := solve(s)
assert(abs(value(answer, u) - 3) < 0.000001)
print("huak compiled bytecode: native geometry and retained Typst text")

