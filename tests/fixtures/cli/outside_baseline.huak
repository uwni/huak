import paint.{rgb, translate, compound, fill, label, outlines, picture};import assertions.assert
export pic:=picture(100,100)
default pic
t:=typ[
#block(height:1pt)[X]
]
assert(t.baseline>t.height)
object.append(pic, object.label(t, (20,60)))
object.append(pic, object.fill(compound(outlines(t).paths), rgb(0,0,0), translate((45,60))))
