import paint.{rgb, rectangle, fill, picture};fn marker(dst: object, at: vec2) -> void
    object.append(dst, object.fill(rectangle(at, 4, 5), rgb(1, 0, 0)))
end
selected := picture(90, 45); other := picture(200, 100); alias := selected
export selected; export alias; export other
alias.marker((2, 3))
selected.marker((40, 20))
object.append(other, object.fill(rectangle((0, 0), 200, 100), rgb(0, 1, 0)))
