import math.{abs, norm};import paint.{rgb, pen, translate, rectangle, path, bezier, bounds, draw, fill, label, picture};import geometry.{clipped, region_union, region_intersection, region_difference, region_xor, offset, clip_region, clip_lines};import pen.stroke_path;import assertions.assert
import "lib/regions.huak" as regions
combined := regions.base.region_union(regions.overlap, 0.001mm, "nonzero")
intersection := region_intersection(regions.base, regions.overlap)
difference := regions.notch(regions.base, regions.overlap)
exclusive := region_xor(regions.base, regions.overlap)
assert(len(region_difference(regions.base, regions.base)) == 0)
assert(len(region_intersection(regions.base, rectangle((30mm, 0), 2mm, 2mm))) == 0)
assert(len(offset(regions.base, -6mm)) == 0)
assert(len(stroke_path(path((0, 0), (1mm, 0)), 0mm)) == 0)
assert(norm(combined.bounds()[0]-(0mm, 0mm)) < 0.0001mm)
assert(norm(combined.bounds()[1]-(15mm, 10mm)) < 0.0001mm)
assert(norm(intersection.bounds()[0]-(5mm, 0mm)) < 0.0001mm)
assert(norm(intersection.bounds()[1]-(10mm, 10mm)) < 0.0001mm)
assert(norm(difference.bounds()[1]-(5mm, 10mm)) < 0.0001mm)
assert(len(exclusive) > len(combined))
grown := combined.offset(1mm, "miter", 4, 0.001mm, "nonzero")
shrunk := offset(combined, -1mm)
assert(norm(grown.bounds()[0]-(-1mm, -1mm)) < 0.0001mm)
assert(norm(grown.bounds()[1]-(16mm, 11mm)) < 0.0001mm)
assert(norm(shrunk.bounds()[0]-(1mm, 1mm)) < 0.0001mm)
assert(norm(shrunk.bounds()[1]-(14mm, 9mm)) < 0.0001mm)
stroke := path((0, 0), (10mm, 0)).stroke_path(2mm, "butt", "miter", 4, 0.001mm)
assert(norm(stroke.bounds()[0]-(0mm, -1mm)) < 0.0001mm)
assert(norm(stroke.bounds()[1]-(10mm, 1mm)) < 0.0001mm)
border := stroke_path(regions.base, 1mm, "round", "round")
cropped := clip_region(regions.base, (2mm, 2mm), (8mm, 8mm), 0.001mm)
assert(norm(cropped.bounds()[0]-(2mm, 2mm)) < 0.0001mm)
assert(norm(cropped.bounds()[1]-(8mm, 8mm)) < 0.0001mm)
curve := bezier((0, 0), (3mm, 8mm), (7mm, 8mm), (10mm, 0))
clipped_curve := curve.clip_lines((2mm, 0), (8mm, 10mm), 0.01mm)
exact := clipped(curve, (2mm, 0), (8mm, 10mm))
assert(abs(clipped_curve.bounds()[0].x-2mm) < 0.001mm)
assert(abs(clipped_curve.bounds()[1].x-8mm) < 0.001mm)
export pic := picture(65mm, 35mm)
default pic
object.append(pic, object.fill(combined, rgb(0.2, 0.4, 0.8), translate((3mm, 3mm))))
object.append(pic, object.fill(difference, rgb(0.8, 0.2, 0.1), translate((23mm, 3mm))))
object.append(pic, object.fill(exclusive, rgb(0.2, 0.7, 0.3), translate((38mm, 3mm))))
object.append(pic, object.fill(stroke, rgb(0, 0, 0), translate((3mm, 18mm))))
object.append(pic, object.fill(border, rgb(0.5, 0.2, 0.7), translate((23mm, 18mm))))
object.append(pic, object.draw(clipped_curve, pen(rgb(0, 0, 0), 0.3mm), translate((43mm, 18mm))))
caption := typ[
Native polygon regions Ω
]
object.append(pic, object.label(caption, (3mm, 32mm)))
