import paint.{rgb, pen, pencircle, pensquare, makepen, makepath, penoffset, stroke_outline, translate, scale, rotate, path, smooth, transformed, draw, fill, label, picture};import assertions.assert
export pic:=picture(12cm,8cm)
default pic
blue:=rgb(0.1,0.3,0.8)
curve:=smooth([(1cm,1cm),(3cm,3cm),(5cm,1cm)])
ordinary:=pen(blue,0.6mm,"round","bevel",8,[3mm,1mm],0.5mm)
object.append(pic, draw(curve, ordinary))
ellipse:=transformed(transformed(pencircle(3mm,blue),scale(1,0.2)),rotate(30deg))
object.append(pic, draw(curve, ellipse, translate((0,3cm))))
square:=pensquare(2mm,rgb(0.8,0.1,0.2))
outline:=stroke_outline(path((7cm,1cm),(10cm,3cm)),square,0.01mm)
object.append(pic, fill(outline, rgb(0.8,0.1,0.2)))
polygon:=makepen(path([(-1mm,-1mm),(1mm,-1mm),(0,2mm)],true),blue)
object.append(pic, draw(path((7cm,4cm),(10cm,6cm)), polygon))
nibpath:=makepath(polygon)
assert(len(nibpath)>0)
tip:=penoffset(square,(1,0))
assert(tip.y==-1mm)
caption:=typ[
Native pens Ω
]
object.append(pic, object.label(caption, (5mm,7cm)))
