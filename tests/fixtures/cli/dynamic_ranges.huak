import assertions.assert
bounds := [1, 3]
sum := 0
for i in bounds[0]:bounds[1] do
    sum = sum+i
end
assert(sum == 6)
large := [9007199254740993, 9007199254740993]
visits := 0; last := 0
for j in large[0]:large[1] do
    assert(j == 9007199254740993)
    visits = visits+1; last = j
end
assert(visits == 1)
descending := [9223372036854775807, -1, 9223372036854775806]
for k in descending[0]:descending[1]:descending[2] do
    assert(k >= 9223372036854775806)
end
print(sum); print(last)
