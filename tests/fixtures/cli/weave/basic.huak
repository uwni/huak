import paint.*
import geometry.{compound, region_intersection}
import object.region
import weave.weave
import assertions.assert
import geometry.path_crossings
import math.sqrt

red := pen(rgb(0.8, 0.1, 0.1), 6pt, "round", "round")
blue := pen(rgb(0.1, 0.3, 0.8), 6pt, "round", "round")
a := path((10pt, 50pt), (90pt, 50pt))
b := path((50pt, 10pt), (50pt, 90pt))

export automatic := picture(100pt, 100pt)
default automatic
drawing automatic do
    +weave(gap:4pt) do
        +draw a with red
        +draw b with blue
    end
end
assert(len(region_intersection(region(automatic), rectangle((44pt, 49pt), 2pt, 2pt))) == 0, "weave clearance must be empty")
assert(len(region_intersection(region(automatic), rectangle((49pt, 49pt), 2pt, 2pt))) > 0, "over passage must remain")
assert(len(region_intersection(region(automatic), rectangle((24pt, 49pt), 2pt, 2pt))) > 0, "unaffected under stroke must remain")

export explicit := picture(100pt, 100pt)
visits := [-1]
drawing explicit do
    +weave(gap:4pt) do
        +draw a with red crossings visits
        visits[0] = 1
        +draw b with blue crossings [1]
    end
end

export reversed := picture(100pt, 100pt)
drawing reversed do
    +weave(gap:4pt) do
        +draw a with red crossings [1]
        +draw b with blue crossings [-1]
    end
end
assert(len(region_intersection(region(reversed), rectangle((49pt, 44pt), 2pt, 2pt))) == 0)
assert(len(region_intersection(region(reversed), rectangle((49pt, 49pt), 2pt, 2pt))) > 0)

export self_crossing := picture(100pt, 100pt)
drawing self_crossing do
    +weave(gap:2pt) do
        +draw (10pt,10pt) -- (90pt, 90pt) -- (10pt, 90pt) -- (90pt, 10pt) with red crossings [1, -1]
    end
end

export hopf := picture(100pt, 100pt)
drawing hopf do
    +weave(gap:2pt) do
        +draw circle((40pt, 50pt), 25pt) with red crossings [1, -2]
        +draw circle((60pt, 50pt), 25pt) with blue crossings [-1, 2]
    end
end

export partial_hopf := picture(100pt, 100pt)
drawing partial_hopf do
    +weave(gap:2pt) do
        +draw circle((40pt, 50pt), 25pt) with red crossings [1, -2]
        +draw circle((60pt, 50pt), 25pt) with blue
    end
end

export partial_second_hopf := picture(100pt, 100pt)
drawing partial_second_hopf do
    +weave(gap:2pt) do
        +draw circle((40pt, 50pt), 25pt) with red
        +draw circle((60pt, 50pt), 25pt) with blue crossings [-1, 2]
    end
end

caption := typ[Hopf link]
variants := [hopf, partial_hopf, partial_second_hopf]
for i in 0:2 do object.append(variants[i], label(caption, (10pt, 90pt))) end

// A genuinely closed three-cubic trefoil, with three crossings and six visits.
t0 := (50pt, 74pt)
t1 := (50pt-sqrt(3)*12pt, 38pt)
t2 := (50pt+sqrt(3)*12pt, 38pt)
tx := 13.2pt
ty := sqrt(3)*tx
ta := bezier(t0, t0+(26.4pt, 0pt), t1+(tx, -ty), t1)
tb := bezier(t1, t1+(-tx, ty), t2+(tx, ty), t2)
tc := bezier(t2, t2+(-tx, -ty), t0+(-26.4pt, 0pt), t0)
trefoil_curve := closed(ta & tb & tc)
assert(len(path_crossings([trefoil_curve])) == 3, "ordinary trefoil nodes must not be crossings")
export trefoil := picture(100pt, 100pt)
translucent := pen(rgb(0.8, 0.1, 0.1, 0.5), 6pt, "round", "round")
drawing trefoil do
    +weave(gap:2pt) do
        +draw trefoil_curve with translucent crossings [1, -2, 3, -1, 2, -3]
    end
end

// A cut can consume an entire contour, or the entire strand.
short := path((50pt,49pt), (50pt,51pt))
covered := weave(gap:0pt) do
    +draw short
    +draw a with red
end
assert(len(covered.children) == 1)
remote := path((20pt,10pt), (30pt,10pt))
partial := weave(gap:0pt) do
    +draw compound([remote, short]) with false
    +draw a with red
end
assert(len(partial.children) == 2)
remaining := region(partial.children[0])
assert(len(region_intersection(remaining, rectangle((49pt,49pt), 2pt, 2pt))) == 0)
assert(len(region_intersection(remaining, rectangle((24pt,9pt), 2pt, 2pt))) > 0)
print("weave checks passed")
