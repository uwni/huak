// Each weave block collects its own strands and returns their woven picture.
import color.rgb
import object as objects
import assertions.assert
import "std/weave/analysis.huak" as analysis
import "std/weave/render.huak" as render

fn collect(strands:list, curve:path, stroke:any = false, visits:list = [])
    if stroke == false then stroke = pen(rgb(0, 0, 0), 1pt) end
    strands += [analysis.Strand(curve: curve, stroke: stroke, visits: copy(visits))]
end

export expand_block weave(gap:length = 1pt, tolerance:length = 0.001pt) -> picture
    assert(gap >= 0pt, "weave gap must be nonnegative")
    assert(tolerance > 0pt, "weave tolerance must be positive")
    strands := []
    add := collect.with(strands: strands)
    mixfix(add) +draw _ with _ crossings _ in unary
    mixfix(objects.draw) draw _ with _ in logical_or
    ...
    return render.compose(analysis.analyze(strands, tolerance), gap, tolerance)
end
