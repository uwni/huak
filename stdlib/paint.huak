import drawing.drawing
export drawing
import color.rgb
import pen.envelope
import transform.{translate, scale, rotate, transformed}
import geometry.{closed, rectangle, circle, smooth, bezier, reverse, joined, fillet, region_difference}
import object.{clip, reset_clip, draw, fill, filldraw, label, append, bounds, region, snapshot}
import object.transform as transform_object
precedence concatenation
    below path
    above comparison
    associativity left
end
mixfix(joined) _ & _ in concatenation
export rgb, pen, envelope, translate, scale, rotate, transformed
export rectangle, circle, path, smooth, bezier, closed, reverse, joined
export picture, object, clip, reset_clip, bounds, draw, fill, filldraw, label, append

// Composable object expressions and word operators. Detailed policy controls
// remain available in brush/engraving; these functions choose drawing defaults.
import brush
import engraving
import assertions.assert

fn tapered(curve:path, width:length) -> path
    return brush.tapered(curve, width, 48)
end
mixfix(tapered) _ tapered _ in path
export tapered

fn rainbow(curve:path, width:length) -> object
    return brush.rainbow(curve, width, 400)
end
mixfix(rainbow) _ rainbow _ in path
export rainbow

// A black, origin-centered sphere; shifted positions the resulting object.
fn sphere(radius:length) -> object
    return engraving.sphere((0mm, 0mm), radius, rgb(0, 0, 0), 40)
end
mixfix(sphere) sphere _ in unary
export sphere

fn tube(curve:path, diameter:length) -> object
    return engraving.tube(curve, diameter, rgb(0, 0, 0), 15, 80)
end
mixfix(tube) _ tube _ in path
export tube

fn filled(curve:path, ink:color) -> object
    return object(curve, fill: ink)
end
mixfix(filled) _ filled _ in path
export filled

fn at(content:text, position:vec2) -> object
    result := object(content)
    transform_object(result, translate(position))
    return result
end
mixfix(at) _ at _ in path
export at

fn shifted(source:object, offset:vec2) -> object
    return transformed(source, translate(offset))
end
mixfix(shifted) _ shifted _ in path
export shifted

// Radii follow rectangle path order: lower-left, lower-right, upper-right,
// upper-left. A scalar applies the same radius to all four corners.
fn rounded_rect(origin:vec2, width:length, height:length, radii:any) -> path
    assert(width > 0pt and height > 0pt, "rounded rectangle dimensions must be positive")
    return fillet(rectangle(origin, width, height), radii)
end
export rounded_rect

// Clip an independent world-space snapshot. The source keeps its identity,
// ancestors, native text and original clip scopes.
fn clipped(source:object, area:path) -> picture
    result := snapshot(source)
    clip(result, area)
    return result
end
export clipped

// Clip an independent instance snapshot. The mask is the actual ink region;
// text in the copied content stays native and the removed area is transparent.
fn cut(source:object, hole:any, tolerance:length = 0.001pt) -> picture
    assert(not source.animated, "cut requires a static object")
    assert(tolerance > 0pt, "cut tolerance must be positive")
    mask := region(hole, tolerance)
    box := bounds(source)
    if len(box) == 0 or len(mask) == 0 then return snapshot(source) end
    minimum := box[0] - (tolerance, tolerance)
    maximum := box[1] + (tolerance, tolerance)
    domain := rectangle(minimum, maximum.x-minimum.x, maximum.y-minimum.y)
    keep := region_difference(domain, mask, tolerance)
    if len(keep) == 0 then
        return picture()
    end
    return clipped(source, keep)
end
mixfix(cut) _ cut _ in path
export cut

// Call forms belong to the library; native constructors keep their original
// implementation and may still be called with ordinary positional arguments.
mixfix(draw) draw _ in logical_or
mixfix(fill) fill _ in logical_or
mixfix(circle) circle with center _ radius _ in unary
mixfix(rectangle) rectangle with origin _ width _ height _ in unary
mixfix(picture) picture with width _ height _ in unary
mixfix(pen) pen with color _ width _ in unary
mixfix(rgb) rgb with red _ green _ blue _ in unary
mixfix(envelope) envelope of _ with _ in unary

mixfix(tapered) tapered along _ width _ in unary
mixfix(rainbow) rainbow along _ width _ in unary
mixfix(tube) tube along _ diameter _ in unary
