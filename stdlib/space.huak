// Script-built boundary geometry. Projection preserves the source list index.
import projection.{project_scene, model_shape as Shape}
import geometry.{compound, rectangle}
import math.{sin, cos}
import object.region
import assertions.assert
import "std/space/light.huak".{Shade, SmoothField, VisibleFace, smooth_field}
import "std/space/solids.huak".{Tones, toned, flat, shaded, colored}

export Shape
export Shade, SmoothField, VisibleFace, Tones, toned, flat, shaded, colored

export fn torus(major:length, minor:length) -> shape
    return Shape("torus", [major, minor])
end

export fn sphere(radius:length) -> shape
    return Shape("sphere", [radius])
end

export fn cylinder(radius:length, height:length) -> shape
    return Shape("cylinder", [radius, height])
end

export fn cone(base:length, height:length, top:length = 0pt) -> shape
    return Shape("cone", [base, top, height])
end

export fn on_surface(surface:shape, uv:path, face:int = 0) -> shape
    return Shape("surface_curve", [surface, uv, face])
end

export struct Plane
    origin:vec3 = (0, 0, 0)
    u:vec3 = (1, 0, 0)
    v:vec3 = (0, 1, 0)
end

export fn profile(curve:path, plane:Plane = Plane()) -> shape
    return Shape("profile", [curve, plane.origin, plane.u, plane.v])
end

export fn face(profile:any, plane:Plane = Plane()) -> shape
    return Shape("face", [profile, plane.origin, plane.u, plane.v])
end

export fn extrude(profile:any, displacement:vec3, plane:Plane = Plane()) -> shape
    return Shape("extrude", [profile, plane.origin, plane.u, plane.v, displacement])
end

// The default meridian uses radius and height as its two coordinates.
export fn revolve(profile:any, angle:angle = 360deg, axis:vec3 = (0, 0, 1), center:vec3 = (0, 0, 0), plane:Plane = Plane(v: (0, 0, 1))) -> shape
    return Shape("revolve", [profile, plane.origin, plane.u, plane.v, center, axis, angle])
end

export fn box(width:length, depth:length, height:length) -> shape
    assert(width > 0pt and depth > 0pt and height > 0pt, "box dimensions must be positive")
    return extrude(rectangle((0pt, 0pt), width, depth), (0pt, 0pt, height))
end

export fn sweep(profile:any, guide:any) -> shape
    return Shape("sweep", [profile, guide])
end

export fn loft(sections:list, solid:bool = false) -> shape
    if solid then return Shape("solid_loft", sections) end
    return Shape("loft", sections)
end

// A surface through a grid of points: `rows` lists the rows, each of as
// many points, at least two rows of two. It is the C2 B-spline surface OCCT
// interpolates through them all (GeomAPI_PointsToBSplineSurface), one face
// whose parameters run along the rows and across them. A graph z = f(x, y),
// a parametric surface or measured heights are grids of their points.
export fn surface(rows:list) -> shape
    assert(len(rows) >= 2, "a surface needs at least two rows")
    arguments := [len(rows), len(rows[0])]
    for row in rows do arguments += row end
    return Shape("grid", arguments)
end

export struct Camera
    azimuth:angle
    elevation:angle
    focus:length
end

export fn orthographic(azimuth:angle = 35deg, elevation:angle = 30deg) -> Camera
    return Camera(azimuth, elevation, 0pt)
end

export fn perspective(azimuth:angle, elevation:angle, focus:length) -> Camera
    assert(focus > 0pt, "perspective focus must be positive")
    return Camera(azimuth, elevation, focus)
end

// The direction toward a light that keeps its place on the page whatever the
// camera: `right` and `up` lie in the page and `out` points at the reader.
// The default comes from the upper left, in front of the page.
export fn page_light(view:Camera, right:float = -0.55, up:float = 0.6, out:float = 0.58) -> vec3
    sa := sin(view.azimuth)
    ca := cos(view.azimuth)
    se := sin(view.elevation)
    ce := cos(view.elevation)
    return (-right*sa - up*se*ca + out*ce*ca, right*ca - up*se*sa + out*ce*sa, up*ce + out*se)
end

export struct Line
    curve:path
    source:int
    kind:string
    visible:bool
    other_source:int = -1
end

export struct Layer
    faces:list = []
    lines:list = []
end

export struct Projection
    lines:list
    visible_faces:list
    layers:list
end

export fn silhouette(projection:Projection) -> path
    // Visible faces tile the image. Normalize their shared borders in one pass.
    paths := []
    for face in projection.visible_faces do paths += [face.region] end
    return region(compound(paths))
end

// Smooth light replaces the isophote bands with continuous fields on the
// front faces; each region then shows one sheet of its face.
//
// `field` is the script's own field on the faces: a function
// `f(point:vec3, normal:vec3) -> float` of a point of a face, in world
// coordinates, and the unit normal of the side that shows there. Each front
// region gets patches carrying it, sampled at least every `field_step` on
// the page, by default a 32nd of what the faces cover, and finer where the
// patches' corner values stray from it by more than `field_tolerance` at
// their samples (see `colored`). The samples judge the patches: a change
// narrower than the step may go unseen. A field needs an orthographic
// camera, and smooth light or none.
export fn project(shapes:list, view:Camera, tolerance:length = 0.01pt, faces:bool = true, light:any = false, spot:angle = 0deg, isophotes:list = [0, 0.25, 0.5, 0.75], smooth:bool = false, field:any = false, field_tolerance:float = 0, field_step:length = 0pt) -> Projection
    lines := []
    result := project_scene(shapes, view.azimuth, view.elevation, view.focus, tolerance, faces, light, spot, isophotes, smooth, field, field_tolerance, field_step)
    layers := []
    count:int := result[2]
    for i in 0:count-1 do layers += [Layer()] end
    for row in result[0] do
        line := Line(row[0], row[1], row[2], row[3] == 0, row[4])
        lines += [line]
        if faces then layers[count-1-row[3]].lines += [line] end
    end
    for row in result[1] do
        shades := []
        for band in row[4] do shades += [Shade(band[0], band[1])] end
        fields:any := false
        if row[7] != false then fields = smooth_field(row[7]) end
        layers[count-1-row[3]].faces += [VisibleFace(row[0], row[1], row[2], shades, row[5], row[6], fields)]
    end
    front := []
    if count > 0 then front = layers[count-1].faces end
    return Projection(lines, front, layers)
end
