// Script-built boundary geometry. Projection preserves the source list index.
import projection.{project_scene, model_shape as Shape}
import geometry.{compound, rectangle, circle}
import transform.matrix
import object.{region, fill, radial_fill, linear_fill, patch_fill, append}
import paint.clipped
import color.rgb
import assertions.assert

export Shape

export fn torus(major:length, minor:length) -> shape
    return Shape("torus", [major, minor])
end

export fn sphere(radius:length) -> shape
    return Shape("sphere", [radius])
end

export fn cylinder(radius:length, height:length) -> shape
    return Shape("cylinder", [radius, height])
end

export fn cone(base:length, height:length, top:length = 0pt) -> shape
    return Shape("cone", [base, top, height])
end

export fn on_surface(surface:shape, uv:path, face:int = 0) -> shape
    return Shape("surface_curve", [surface, uv, face])
end

export struct Plane
    origin:vec3 = (0, 0, 0)
    u:vec3 = (1, 0, 0)
    v:vec3 = (0, 1, 0)
end

export fn profile(curve:path, plane:Plane = Plane()) -> shape
    return Shape("profile", [curve, plane.origin, plane.u, plane.v])
end

export fn face(profile:any, plane:Plane = Plane()) -> shape
    return Shape("face", [profile, plane.origin, plane.u, plane.v])
end

export fn extrude(profile:any, displacement:vec3, plane:Plane = Plane()) -> shape
    return Shape("extrude", [profile, plane.origin, plane.u, plane.v, displacement])
end

// The default meridian uses radius and height as its two coordinates.
export fn revolve(profile:any, angle:angle = 360deg, axis:vec3 = (0, 0, 1), center:vec3 = (0, 0, 0), plane:Plane = Plane(v: (0, 0, 1))) -> shape
    return Shape("revolve", [profile, plane.origin, plane.u, plane.v, center, axis, angle])
end

export fn box(width:length, depth:length, height:length) -> shape
    assert(width > 0pt and depth > 0pt and height > 0pt, "box dimensions must be positive")
    return extrude(rectangle((0pt, 0pt), width, depth), (0pt, 0pt, height))
end

export fn sweep(profile:any, guide:any) -> shape
    return Shape("sweep", [profile, guide])
end

export fn loft(sections:list, solid:bool = false) -> shape
    if solid then return Shape("solid_loft", sections) end
    return Shape("loft", sections)
end

export struct Camera
    azimuth:angle
    elevation:angle
    focus:length
end

export fn orthographic(azimuth:angle = 35deg, elevation:angle = 30deg) -> Camera
    return Camera(azimuth, elevation, 0pt)
end

export fn perspective(azimuth:angle, elevation:angle, focus:length) -> Camera
    assert(focus > 0pt, "perspective focus must be positive")
    return Camera(azimuth, elevation, focus)
end

export struct Line
    curve:path
    source:int
    kind:string
    visible:bool
    other_source:int = -1
end

export struct Shade
    region:path
    diffuse:float
end

// Continuous light on a visible face, from project(..., smooth: true).
// Diffuse is n·l. Glint is 1 at the center of the highlight, positive inside
// it, and -1 where there is no highlight or the point is unlit. A "constant"
// field has one sample. A "profile" varies only along start -> stop, with
// positions from 0 to 1. "patches" carry sixteen control points and field
// coefficients each (see object.patch_fill): diffuse on points, and the
// glint on finer glint_points where the highlight can reach. They extend past
// the face's region and stay within accuracy of the light, except within
// margin of the region's outline, which is traced only that accurately.
export struct LightField
    kind:string
    diffuse:list
    glint:list
    start:any = false
    stop:any = false
    positions:list = []
    points:list = []
    glint_points:list = []
    accuracy:float = 0
    margin:length = 0pt
end

export struct VisibleFace
    region:path
    source:int
    face:int
    shades:list = []
    highlight:any = false
    lobes:list = []
    field:any = false
end

export struct Layer
    faces:list = []
    lines:list = []
end

export struct Projection
    lines:list
    visible_faces:list
    layers:list
end

export fn silhouette(projection:Projection) -> path
    // Visible faces tile the image. Normalize their shared borders in one pass.
    paths := []
    for face in projection.visible_faces do paths += [face.region] end
    return region(compound(paths))
end

// Palette choice is independent of the geometric light and gleam boundaries.
fn tone(ink:color, level:float) -> color
    if level < 0 then return rgb(ink.r*(1+level), ink.g*(1+level), ink.b*(1+level), ink.a) end
    return rgb(ink.r+(1-ink.r)*level, ink.g+(1-ink.g)*level, ink.b+(1-ink.b)*level, ink.a)
end

// The band palette as color stops over n·l: dark on the unlit side, the ink
// at level 0 and light at n·l = 1. Between stops the tone is linear in n·l.
fn shade_stops(ink:color) -> list
    return [tone(ink, -0.58), ink, tone(ink, 0.33)]
end
SHADE_LEVELS := [0, 0.58 / 0.91, 1]

fn blend(a:color, b:color, t:float) -> color
    return rgb(a.r+(b.r-a.r)*t, a.g+(b.g-a.g)*t, a.b+(b.b-a.b)*t, a.a+(b.a-a.a)*t)
end

fn ramp(colors:list, levels:list, value:float) -> color
    if value <= levels[0] then return colors[0] end
    for k in 1:len(levels)-1 do
        if value <= levels[k] then return blend(colors[k-1], colors[k], (value-levels[k-1])/(levels[k]-levels[k-1])) end
    end
    return colors[len(colors)-1]
end

// Highlight opacity: the band lobes' 0.88 of the ink's alpha at the center,
// fading with the square of the glint to nothing at the highlight's edge.
fn glow(ink:color, glint:float) -> float
    if glint <= 0 then return 0 end
    return 0.88 * ink.a * glint * glint
end

// Gradient stops along a profile: every sample, and where the light crosses
// a palette level between two samples, so the palette's corners stay exact.
fn profile_stops(field:LightField, colors:list, levels:list) -> list
    stops := []
    offsets := []
    for k in 0:len(field.positions)-1 do
        here := field.positions[k]
        light := field.diffuse[k]
        if k > 0 then
            before := field.positions[k-1]
            last := field.diffuse[k-1]
            count := len(levels)
            for step in 0:count-1 do
                index := step
                if last > light then index = count-1-step end
                level := levels[index]
                if (level - last) * (level - light) < 0 then
                    offsets += [before + (here-before)*(level-last)/(light-last)]
                    stops += [colors[index]]
                end
            end
        end
        offsets += [here]
        stops += [ramp(colors, levels, light)]
    end
    return [stops, offsets]
end

fn smooth_shaded(face:VisibleFace, ink:color) -> picture
    result := picture()
    field:LightField := face.field
    colors := shade_stops(ink)
    if field.kind == "patches" then
        append(result, patch_fill(face.region, field.points, field.diffuse, colors, SHADE_LEVELS, field.accuracy, field.margin))
        if len(field.glint) > 0 then
            // Nine stops follow the glow's square within 1/256 of its opacity.
            whites := []
            levels := []
            for k in 0:8 do
                levels += [k / 8]
                whites += [rgb(1, 1, 1, glow(ink, k / 8))]
            end
            append(result, patch_fill(face.region, field.glint_points, field.glint, whites, levels, field.accuracy, field.margin))
        end
        return result
    end
    glows := []
    for glint in field.glint do glows += [glow(ink, glint)] end
    shine := false
    for g in glows do if g > 0 then shine = true end end
    if field.kind == "constant" then
        append(result, fill(face.region, ramp(colors, SHADE_LEVELS, field.diffuse[0])))
        if shine then append(result, fill(face.region, rgb(1, 1, 1, glows[0]))) end
    else
        stops := profile_stops(field, colors, SHADE_LEVELS)
        append(result, linear_fill(face.region, field.start, field.stop, stops[0], stops[1]))
        if shine then
            whites := []
            for g in glows do whites += [rgb(1, 1, 1, g)] end
            append(result, linear_fill(face.region, field.start, field.stop, whites, field.positions))
        end
    end
    return result
end

export fn shaded(face:VisibleFace, ink:color) -> picture
    if face.field != false then return smooth_shaded(face, ink) end
    result := picture()
    assert(len(face.shades) > 0, "shaded needs a projection with a directional light")
    for shade in face.shades do
        append(result, fill(shade.region, tone(ink, -0.58+0.91*shade.diffuse)))
    end
    if face.highlight != false then
        if len(face.lobes) == 0 then
            append(result, fill(face.highlight, tone(ink, 0.70)))
            return result
        end
        spots := picture()
        disk := circle((0pt, 0pt), 1pt)
        for ellipse in face.lobes do
            center := ellipse[0]
            u := ellipse[1]
            v := ellipse[2]
            glint := radial_fill(disk, (0pt, 0pt), 1pt, rgb(1, 1, 1, ink.a*0.88), rgb(1, 1, 1, 0))
            append(spots, glint, matrix(u.x, u.y, v.x, v.y, center.x, center.y))
        end
        append(result, clipped(spots, face.highlight))
    end
    return result
end

fn light_field(row:list) -> LightField
    if row[0] == "constant" then return LightField("constant", [row[1]], [row[2]]) end
    if row[0] == "profile" then return LightField("profile", row[4], row[5], start: row[1], stop: row[2], positions: row[3]) end
    return LightField("patches", row[2], row[4], points: row[1], glint_points: row[3], accuracy: row[5], margin: row[6])
end

// Smooth light replaces the isophote bands with continuous fields on the
// front faces; each region then shows one sheet of its face.
export fn project(shapes:list, view:Camera, tolerance:length = 0.01pt, faces:bool = true, light:any = false, spot:angle = 0deg, isophotes:list = [0, 0.25, 0.5, 0.75], smooth:bool = false) -> Projection
    lines := []
    result := project_scene(shapes, view.azimuth, view.elevation, view.focus, tolerance, faces, light, spot, isophotes, smooth)
    layers := []
    count:int := result[2]
    for i in 0:count-1 do layers += [Layer()] end
    for row in result[0] do
        line := Line(row[0], row[1], row[2], row[3] == 0, row[4])
        lines += [line]
        if faces then layers[count-1-row[3]].lines += [line] end
    end
    for row in result[1] do
        shades := []
        for band in row[4] do shades += [Shade(band[0], band[1])] end
        field:any := false
        if row[7] != false then field = light_field(row[7]) end
        layers[count-1-row[3]].faces += [VisibleFace(row[0], row[1], row[2], shades, row[5], row[6], field)]
    end
    front := []
    if count > 0 then front = layers[count-1].faces end
    return Projection(lines, front, layers)
end
