// Local clearance policy. Native stroke sections retain the source pen's
// dash, cap and join semantics; the original stroke is rendered only once.
import geometry.{compound, contour_ranges, offset, region_difference, region_union}
import pen.stroke_sections
import object.draw
import math.floor
import "std/weave/analysis.huak" as analysis

struct Sections
    original:list
    remaining:list
    changed:bool = false
end

// Any strict interior cut separates these visits. Reuse an existing source
// knot when available, rather than manufacture a tiny fragment beside it.
fn partition(first:float, last:float) -> float
    middle := (first+last)/2
    node := floor(middle)
    if middle-node > 0.5 then node = node+1 end
    if first < node and node < last then return node end
    return middle
end

fn sections(strand:analysis.Strand, visits:list, tolerance:length) -> Sections
    if len(visits) == 0 then return Sections(original: [], remaining: []) end
    contours := contour_ranges(strand.curve)
    ranges := []
    wraps := []
    cursor := 0
    for contour in 0:len(contours)-1 do
        start:float := contours[contour][0]
        stop:float := contours[contour][1]
        period := stop-start
        first := cursor
        while cursor < len(visits) and visits[cursor].contour == contour do cursor = cursor+1 end
        if first == cursor then
            ranges += [[contour, start, stop]]
        else
            // On a closed contour the last and first visits are neighbors.
            // Choose their boundary on the unwrapped time axis.
            seam := stop
            if contours[contour][2] and cursor-first > 1 then
                seam = partition(visits[cursor-1].time, visits[first].time+period)
            end
            begin := seam-period
            for i in first:cursor-1 do
                passage:analysis.Passage := visits[i]
                finish := seam
                if i+1 < cursor then finish = partition(passage.time, visits[i+1].time) end
                passage.section = len(ranges)
                if begin < start then
                    wraps += [[passage.section, [contour, begin+period, stop]]]
                    begin = start
                elseif finish > stop then
                    wraps += [[passage.section, [contour, start, finish-period]]]
                    finish = stop
                end
                ranges += [[contour, begin, finish]]
                begin = finish
            end
        end
    end
    // stroke_sections preserves the original dash phase on both sides of a
    // seam. Reunite the two ranges before using this passage as a mask or cut.
    count := len(ranges)
    for wrap in wraps do ranges += [wrap[1]] end
    coverage := stroke_sections(strand.curve, strand.stroke, ranges, tolerance)
    original := coverage[0:count-1]
    for j in 0:len(wraps)-1 do
        owner:int := wraps[j][0]
        original[owner] = region_union(original[owner], coverage[count+j], tolerance)
    end
    return Sections(original: original, remaining: copy(original))
end

export fn compose(plan:analysis.Plan, gap:length, tolerance:length) -> picture
    parts := []
    for i in 0:len(plan.strands)-1 do parts += [sections(plan.strands[i], plan.visits[i], tolerance)] end
    for i in 0:len(plan.crossings)-1 do
        crossing:analysis.Crossing := plan.crossings[i]
        over := crossing.first
        under := crossing.second
        if not over.over then over = crossing.second; under = crossing.first end
        mask:path := parts[over.strand].original[over.section]
        if gap > 0pt then mask = offset(mask, gap, "round", 4, tolerance) end
        lower:Sections := parts[under.strand]
        lower.remaining[under.section] = region_difference(lower.remaining[under.section], mask, tolerance)
        lower.changed = true
    end
    result := picture()
    for i in 0:len(plan.strands)-1 do
        strand:analysis.Strand := plan.strands[i]
        pieces:Sections := parts[i]
        target:object := result
        if pieces.changed then
            keep := compound([])
            for piece in pieces.remaining do keep = region_union(keep, piece, tolerance) end
            if len(keep) == 0 then continue end
            child := picture()
            object.clip(child, keep)
            target = object.append(result, child)
        end
        object.append(target, draw(strand.curve, strand.stroke))
    end
    return result
end
