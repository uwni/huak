{
  "comments": { "lineComment": "//" },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [{ "open": "(", "close": ")" }, { "open": "[", "close": "]" }, { "open": "{", "close": "}" }, { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["{", "}"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:else|elseif|then)\\b|.*\\b(?:fn|expand_block|block|struct|if|do|precedence)\\b)(?!.*\\bend\\b).*$",
    "decreaseIndentPattern": "^\\s*(?:end|else|elseif|then)\\b"
  },
  "folding": { "markers": { "start": "^\\s*//\\s*region\\b", "end": "^\\s*//\\s*endregion\\b" } }
}
