{
  "comments": { "lineComment": "//" },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [{ "open": "(", "close": ")" }, { "open": "[", "close": "]" }, { "open": "{", "close": "}" }, { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["{", "}"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:if|elseif)\\b.*\\bthen|(?:for|while|drawing)\\b.*\\bdo|(?:export\\s+)?(?:fn|struct)\\b|precedence\\b|else\\b)(?!.*\\bend\\b).*$",
    "decreaseIndentPattern": "^\\s*(?:end|else|elseif)\\b"
  },
  "folding": { "markers": { "start": "^\\s*(?://|#)\\s*region\\b", "end": "^\\s*(?://|#)\\s*endregion\\b" } }
}
