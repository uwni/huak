import paint.{bounds, width, height, assert}
import "../../nodegraph.huak".*
import assertions.assert
n := node("db", absolute((0pt, 0pt)), typ[DB], {"shape": "cylinder", "width": 60pt, "height": 40pt, "shape_options": {"rings": [-8pt, 8pt]}})
p := diagram([n])
assert(len(bounds(p)) == 2, "cylinder rings must render")
print("cylinder checks passed")
tilted := node("tilt", absolute((100pt, 0pt)), typ[DB], {"shape": "cylinder", "width": 60pt, "height": 40pt, "shape_options": {"tilt": 20deg}})
assert(len(bounds(diagram([tilted]))) == 2, "tilted cylinder must render")
