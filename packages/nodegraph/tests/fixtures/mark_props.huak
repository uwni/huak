import paint.{rgb, path, bounds, circle}
import object.region
import geometry.region_intersection
import assertions.assert
import "../../nodegraph.huak".*
import "../../nodegraph/marks.huak" as marks
import "../../nodegraph/model.huak" as model
a := marks.render(model.mark("head", 1, false, {"size": 8pt}), path((-100pt, 0pt), (0pt, 0pt)), rgb(0, 0, 0), 1pt, 8pt)
b := marks.render(model.mark("head", 1, false, {"size": 8pt, "sharpness": 30deg, "delta": 40deg, "stroke": rgb(1, 0, 0)}), path((-100pt, 0pt), (0pt, 0pt)), rgb(0, 0, 0), 1pt, 8pt)
assert(len(bounds(a.content)) == 2 and len(bounds(b.content)) == 2, "mark properties must render")
print("mark properties checks passed")
plain_edge := edge(absolute((0pt, 0pt)), absolute((100pt, 0pt)), {"marks": [mark("head", 1, false, {"size": 8pt})]})
origin_edge := edge(absolute((0pt, 0pt)), absolute((100pt, 0pt)), {"marks": [mark("head", 1, false, {"size": 8pt, "tip_origin": 10pt})]})
pa := bounds(diagram([plain_edge]))
pb := bounds(diagram([origin_edge]))
assert(pb[1].x > pa[1].x+2pt, "tip_origin must move the mark")

// A cross is two symmetric diagonals; a slash is one stroke rising at 60deg.
guide := path((-100pt, 0pt), (100pt, 0pt))
cross := bounds(marks.render(model.mark("cross", 0.5), guide, rgb(0, 0, 0), 1pt, 20pt).content)
cross_width := cross[1].x-cross[0].x
cross_height := cross[1].y-cross[0].y
assert(cross_width-cross_height < 0.001pt and cross_height-cross_width < 0.001pt, "cross mark must be symmetric")
slash := region(marks.render(model.mark("slash", 0.5), guide, rgb(0, 0, 0), 1pt, 20pt).content, 0.01pt)
assert(len(bounds(region_intersection(slash, circle((5pt, 8.66pt), 0.2pt), 0.01pt))) == 2, "slash must rise to the right")
assert(len(bounds(region_intersection(slash, circle((-5pt, 8.66pt), 0.2pt), 0.01pt))) == 0, "slash must not mirror into a cross")
print("cross and slash checks passed")
