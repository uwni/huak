// The same local arrowheads, placed rigidly or bent along the guide.
import paint.*
import "../nodegraph.huak".{absolute, edge, mark, node, diagram}
import "../nodegraph/curves.huak" as curves

fn panel(bend:bool) -> picture
    items := []
    kinds := ["head", "solid", "stealth", "latex", "harpoon", "doublehead"]
    ink := rgb(0.08, 0.36, 0.66)
    for i in 0:len(kinds)-1 do
        kind := kinds[i]
        typst_expose kind
        origin := (35pt+(i%3)*75pt, 105pt-int(i/3)*75pt)
        guide := curves.arc(origin, 26pt, 0deg, 100deg)
        items += edge(absolute(point_at(guide, 0)), absolute(point_at(guide, len(guide))), {"curve": guide, "stroke": ink, "thickness": 1.2pt, "marks": [mark(kind, 1, false, {"size": 18pt, "bend": bend})]})
        items += node(kind, absolute(origin+(8pt, -16pt)), typ[#huak.kind], {"shape": "none", "snap": false})
    end
    return diagram(items, {"margin": 12pt})
end

export comparison := picture(500pt, 195pt)
default comparison
drawing comparison do
    +typ[*Rigid placement*] at (65pt, 178pt)
    +typ[*Bent along the path*] at (305pt, 178pt)
    +panel(false)
    +panel(true) shifted (250pt, 0pt)
end
