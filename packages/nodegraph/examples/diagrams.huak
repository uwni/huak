// Run from the repository: huak run packages/nodegraph/examples/diagrams.huak
//   --output commutative=commutative.svg --output flowchart=flowchart.pdf
// Explicit source import is intentional while the Zig catalog is unchanged.
import paint.*
import "../nodegraph.huak".{anchor, diagram, wire, finish, grid, absolute, named, automatic, shift, node, enclose, edge, connect, arrows, part}
// Math has no label syntax, so mark boxes an entry and labels the box. The
// box sets its fill so that the red boxes below do not reach it.
parts := typ.module[#let mark(name, body) = [#box(fill: none, $body$)#label(name)]]
red_boxes := typ.module[
  #let style(body) = {
    set block(fill: red)
    set box(fill: red)
    body
  }
]
typ.show red_boxes.style

// Typst lays out the whole square as one matrix; edges reach its labeled
// entries with part(...).
square := named("square")
commuting := [
    node("square", grid(0, 0), typ[$mat(delim: #none, column-gap: #4em, row-gap: #3.5em,
        huak.parts.mark("G", G), huak.parts.mark("image", "im"(f));
        huak.parts.mark("quotient", G / "ker"(f)), huak.parts.mark("H", H))$]),
    edge(part(square, "G"), part(square, "image"), {"label": typ[$f$]}),
    edge(part(square, "G"), part(square, "quotient"), {"label": typ[$pi$], "marks": arrows("->>")}),
    edge(part(square, "quotient"), part(square, "image"), {"label": typ[$tilde(f)$], "marks": arrows("hook->")}),
    edge(part(square, "quotient"), part(square, "H"), {"marks": arrows("-|>")}),
]
export commutative := diagram of commuting
default commutative


flow := [
    node("start", grid(0, 0), typ[Start], {"shape": "pill"}),
    edge(automatic(), automatic()),
    node("question", grid(0, 1), typ[Ready?], {"shape": "diamond"}),
    node("finish", grid(1, 1), typ[Finish], {"shape": "pill"}),
    connect("question", "finish", {"head": "solid", "label": typ[Yes]}),
    connect("question", "start", {"corner": "vertical", "shift": -12pt, "label": typ[No], "label_side": "right"}),
]
export flowchart := diagram(flow, {"node_options": {"thickness": 0.7pt, "fill": rgb(0.9, 0.95, 1)}})

states := [
    node("reading", grid(0, 0), typ[reading], {"shape": "circle"}),
    node("eof", grid(1, 0), typ[eof], {"shape": "circle"}),
    node("closed", grid(2, 0), typ[closed], {"shape": "circle", "extrude": [-2pt, 0pt]}),
    connect("reading", "reading", {"label": typ[read], "loop_angle": 90deg}),
    connect("reading", "eof", {"label": typ[read]}),
    connect("eof", "closed", {"label": typ[close]}),
    connect("reading", "closed", {"bend": 30deg, "label": typ[close], "label_side": "right"}),
]
export state_machine := diagram(states, {"spacing": (54pt, 24pt), "node_options": {"thickness": 0.7pt}})

grouped := [
    node("a", grid(0, 0), typ[A]),
    node("b", grid(1, 0), typ[B]),
    node("c", grid(2, 0), typ[C]),
    enclose("ab", ["a", "b"], typ[], {"layer": -2, "inset": 12pt, "corner_radius": 5pt, "fill": rgb(0.9, 0.95, 1), "thickness": 0.6pt}),
    enclose("outer", ["ab", "c"], typ[], {"layer": -3, "inset": 8pt, "thickness": 0.6pt}),
    connect("a", "b", {"name": "ab_edge"}),
    connect("b", "c"),
    edge(named("ab_edge"), absolute((40pt, -60pt)), {"head": "solid", "label": typ[edge anchor]}),
]
export groups := diagram(grouped)

// A center label and an overpassing wire really cut the lower objects; neither
// paints a white backdrop. The same export works on any page background.
crossings := [
    edge(absolute((0pt, 0pt)), absolute((160pt, 80pt)), {"head": "none", "thickness": 5pt, "stroke": rgb(0.15, 0.45, 0.8)}),
    edge(absolute((0pt, 80pt)), absolute((160pt, 0pt)), {"head": "solid", "thickness": 3pt, "stroke": rgb(0.85, 0.2, 0.15), "crossing": true, "crossing_width": 10pt}),
    edge(absolute((0pt, 40pt)), absolute((160pt, 40pt)), {"head": "head", "label": typ[Native text], "label_side": "center", "layer": 1}),
]
export transparent_crossings := diagram(crossings)
