// Node-and-arrow diagrams expressed entirely in Huak source.
import geometry.{circle, compound}
import object.draw
import color.rgb
import assertions.assert
import "nodegraph/model.huak".{GridCoordinate, AbsoluteCoordinate, NamedCoordinate, RelativeCoordinate, BetweenCoordinate, AutomaticCoordinate, NodeDescription, EnclosureDescription, EdgeDescription, MarkDescription, grid, absolute, named, relative, polar, between, automatic, shift, node, enclose, edge, connect, hide, mark}
import "nodegraph/marks.huak".arrows
import "nodegraph/shapes.huak".{shape_outline, rounded_rect, ellipse_shape, stretched_glyph}
import "nodegraph/options.huak" as opt
import "nodegraph/layout.huak" as layout
import "nodegraph/edges.huak" as edges
import "nodegraph/render.huak" as render

// A drawing block target. Commands append deferred descriptions; finish()
// resolves layout once and leaves the resulting picture and geometry on the
// scene. This is the Huak-native entry point; list-based composition remains
// available through diagram(items).
export struct Scene
    items:list = []
    options:dict = {}
    picture:picture = picture(640, 480)
    geometry:layout.Geometry = layout.Geometry(objects: [], by_name: {})
    finished:bool = false
    next:int = 0
    kind:string = "scene"
end

// Handles returned by scene commands. The name is an internal identity; users
// bind handles to ordinary Huak variables and never spell names.
export struct NodeHandle
    name:string
    kind:string = "node_handle"
end

export struct EdgeHandle
    name:string
    kind:string = "edge_handle"
end

export fn scene(options:dict = {}) -> Scene
    opt.validate(options, ["spacing", "cell_size", "axes", "margin", "node_options", "edge_options", "node_defocus", "debug", "debug_level"])
    return Scene(options: options)
end

fn debug_grid(dst:object, resolved:layout.Geometry)
    if len(resolved.cells) != 2 then return end
    xs:list := resolved.cells[0]
    ys:list := resolved.cells[1]
    if len(xs) == 0 or len(ys) == 0 then return end
    x0:length := xs[0].center-xs[0].width/2
    x1:length := xs[len(xs)-1].center+xs[len(xs)-1].width/2
    y0:length := ys[0].center-ys[0].width/2
    y1:length := ys[len(ys)-1].center+ys[len(ys)-1].width/2
    x_axis:pair := resolved.axes[0]
    y_axis:pair := resolved.axes[1]
    basis := transform.matrix(x_axis.x, x_axis.y, y_axis.x, y_axis.y, 0pt, 0pt)
    ink := pen(rgb(0.55, 0.62, 0.75), 0.25pt)
    for i in 0:len(xs)-1 do
        x:length := xs[i].center-xs[i].width/2
        object.append(dst, draw(path((x, y0), (x, y1)), ink, basis))
    end
    object.append(dst, draw(path((x1, y0), (x1, y1)), ink, basis))
    for i in 0:len(ys)-1 do
        y:length := ys[i].center-ys[i].width/2
        object.append(dst, draw(path((x0, y), (x1, y)), ink, basis))
    end
    object.append(dst, draw(path((x0, y1), (x1, y1)), ink, basis))
end

fn configured(items:list, options:dict) -> list
    result := []
    names := {}
    for i in 0:len(items)-1 do
        item:any := items[i]
        kind:string := item.kind
        assert(kind == "node" or kind == "edge" or kind == "enclose", "unknown diagram item")
        fallback:dict := opt.get(options, "node_options", {})
        if kind == "edge" then fallback = opt.get(options, "edge_options", {})
        else fallback = opt.setting(fallback, "defocus", opt.get(options, "node_defocus", 0.2)) end
        settings := opt.defaults(item.options, fallback)
        name:string := item.name
        if kind == "edge" then name = opt.get(settings, "name", name) end
        if name != "" then
            assert(not dict_contains(names, name), "duplicate diagram object name: " + name)
            names[name] = true
        else assert(kind == "edge", "nodes must have a nonempty name") end
        if kind == "node" then result += [node(name, item.position, item.body, settings)]
        elseif kind == "enclose" then result += [enclose(name, item.members, item.body, settings)]
        else
            first:any := item.first
            last:any := item.last
            if first.kind == "auto" then
                found := false
                for j in i-1:-1:0 do
                    if not found and items[j].kind != "edge" then first = named(items[j].name); found = true end
                end
                assert(found, "automatic edge start has no preceding node")
            end
            if last.kind == "auto" then
                found := false
                for j in i+1:len(items)-1 do
                    if not found and items[j].kind != "edge" then last = named(items[j].name); found = true end
                end
                assert(found, "automatic edge end has no following node")
            end
            result += [edge(first, last, settings)]
        end
    end
    return result
end

// Returns resolved geometry, useful for composing diagrams with other drawings.
// Node positions and all text frames are retained; no text is outlined.
export fn geometry(items:list, options:dict = {}) -> layout.Geometry
    opt.validate(options, ["spacing", "cell_size", "axes", "margin", "node_options", "edge_options", "node_defocus", "debug", "debug_level"])
    descriptions := configured(items, options)
    prepared := layout.nodes(descriptions, options)
    connectors := edges.resolve(descriptions, prepared)
    result := prepared.geometry
    result.objects = descriptions
    for connector in connectors do result.objects[connector.source_index] = connector end
    for i in 0:len(descriptions)-1 do
        item:any := result.objects[i]
        if item.kind == "edge" then
            if item.name != "" then result.by_name[item.name] = item end
        else result.objects[i] = layout.find(result, item.name) end
    end
    return result
end

export fn anchor(objects:any, name:string, side:string = "center") -> pair
    if objects.kind == "scene" then
        finish(objects)
        return layout.anchor(objects.geometry, name, side)
    end
    return layout.anchor(objects, name, side)
end

export fn route(objects:any, name:string) -> path
    if objects.kind == "scene" then
        finish(objects)
        objects = objects.geometry
    end
    item := layout.find(objects, name)
    assert(item.kind == "edge", "route requires a named edge")
    return item.curve
end

export fn diagram(items:list, options:dict = {}) -> picture
    return render_geometry(geometry(items, options), options)
end

fn render_geometry(objects:layout.Geometry, options:dict) -> picture
    pictures := []
    for item in objects.objects do
        if item.kind == "edge" then pictures += [render.edge_object(item)]
        else pictures += [render.node_object(item)] end
    end
    level:int := opt.get(options, "debug_level", 0)
    if opt.get(options, "debug", false) or level >= 1 then
        debug := picture()
        debug_grid(debug, objects)
        if opt.get(options, "debug", false) or level >= 2 then
            for item in objects.objects do
                if item.kind != "edge" then
                    center:pair := item.center
                    object.append(debug, draw(circle(center, 2pt), pen(rgb(0.85, 0.2, 0.2), 0.5pt)))
                end
            end
        end
        pictures += [render.PaintedObject(content: debug, clearance: compound([]), layer: 1000000, floating: true)]
    end
    return render.compose_objects(pictures, opt.get(options, "margin", 6pt))
end

// Scene commands return handles so node identity is an ordinary Huak variable,
// not a string label.
fn fresh(target:Scene, prefix:string) -> string
    name := prefix+str(target.next)
    target.next = target.next + 1
    return name
end

export fn place(target:Scene, body:text, position:any, options:dict = {}) -> NodeHandle
    name := fresh(target, "n")
    target.items += [node(name, position, body, options)]
    return NodeHandle(name: name)
end

export fn link(target:Scene, first:NodeHandle, last:NodeHandle, options:dict = {}) -> EdgeHandle
    name := fresh(target, "e")
    target.items += [connect(first.name, last.name, opt.setting(options, "name", name))]
    return EdgeHandle(name: name)
end

export fn wire(target:Scene, first:any, last:any, options:dict = {}) -> EdgeHandle
    name := fresh(target, "e")
    target.items += [edge(first, last, opt.setting(options, "name", name))]
    return EdgeHandle(name: name)
end

export fn group(target:Scene, members:list, body:text, options:dict = {}) -> NodeHandle
    names := []
    for i in 0:len(members)-1 do
        member:any := members[i]
        assert(member.kind == "node_handle", "group members must be node handles")
        names += [member.name]
    end
    name := fresh(target, "g")
    target.items += [enclose(name, names, body, options)]
    return NodeHandle(name: name)
end

export fn matrix(target:Scene, rows:list, options:dict = {}) -> list
    result := []
    for row in 0:len(rows)-1 do
        cells:list := rows[row]
        for column in 0:len(cells)-1 do
            result += [place(target, cells[column], grid(column, row), options)]
        end
    end
    return result
end

export fn anchor_node(target:Scene, node:NodeHandle, side:string = "center") -> pair
    finish(target)
    return layout.anchor(target.geometry, node.name, side)
end

export fn route_edge(target:Scene, edge:EdgeHandle) -> path
    finish(target)
    item := layout.find(target.geometry, edge.name)
    assert(item.kind == "edge", "route_edge requires an edge handle")
    return item.curve
end

// Resolve and render exactly once; usable inside a block or directly.
export fn finish(target:Scene) -> picture
    if target.finished then return target.picture end
    target.geometry = geometry(target.items, target.options)
    target.picture = render_geometry(target.geometry, target.options)
    target.finished = true
    return target.picture
end


export expand_block drawing(target:Scene)
    place := place.with(target: target)
    link := link.with(target: target)
    wire := wire.with(target: target)
    group := group.with(target: target)
    matrix := matrix.with(target: target)
    mixfix(place) place _ at _ in unary
    mixfix(link) link _ to _ in unary
    mixfix(wire) wire _ to _ in unary
    mixfix(group) group _ containing _ with _ in unary
    mixfix(matrix) matrix _ in unary
    ...
    return finish(target)
end

// Huak owns the matrix, so Typst mathematical content needs no inspection.
// Rows may be ragged. Stable names are r0c0, r0c1, r1c0, ... .
export fn matrix_nodes(rows:list, options:dict = {}) -> list
    result := []
    for row in 0:len(rows)-1 do
        cells:list := rows[row]
        for column in 0:len(cells)-1 do
            result += [node("r"+str(row)+"c"+str(column), grid(column, row), cells[column], options)]
        end
    end
    return result
end

mixfix(node) node named _ at _ containing _ in unary
mixfix(connect) connect from _ to _ in unary
mixfix(edge) edge from _ to _ with _ in unary
mixfix(enclose) enclose named _ around _ containing _ in unary
mixfix(diagram) diagram of _ in unary
export GridCoordinate, AbsoluteCoordinate, NamedCoordinate, RelativeCoordinate, BetweenCoordinate, AutomaticCoordinate
export NodeDescription, EnclosureDescription, EdgeDescription, MarkDescription
export grid, absolute, named, relative, polar, between, automatic, shift
export node, enclose, edge, connect, hide, mark, arrows
export shape_outline, rounded_rect, ellipse_shape, stretched_glyph
