// 各部件以自己的定位點為原點，x 向右、y 向上。輸出皆為未描邊的刀路。
import paint.*
import geometry.compound
import math.{min, norm, unit}

fn in_points(p:vec2) -> vec2
    return p * 1pt
end

fn seal_curve(a:vec2,b:vec2,c:vec2,d:vec2) -> path
    return bezier(in_points(a),in_points(b),in_points(c),in_points(d))
end

// Straight runs meet at a short quadratic shoulder. The setback is limited
// by both runs so that a short hook keeps its full length.
fn folded(points:list, setback:length = 1pt) -> path
    first := in_points(points[0])
    last := in_points(points[len(points)-1])
    result := first -- last
    if len(points) == 2 then return result end
    tip := first
    for i in 1:len(points)-2 do
        corner := in_points(points[i])
        incoming := corner - in_points(points[i-1])
        outgoing := in_points(points[i+1]) - corner
        r := min(setback, 0.4 * min(norm(incoming), norm(outgoing)))
        a := corner - unit(incoming) * r
        b := corner + unit(outgoing) * r
        run := tip -- a
        if i == 1 then result = run else result = result & run end
        result = result & bezier(a, a + (corner-a)*2/3, b + (corner-b)*2/3, b)
        tip = b
    end
    return result & (tip -- last)
end

// 煢。兩火各以中豎頂端定位，冖以弧頂定位，卂以豎腳定位。
export fire_left := compound([
    folded([(-8.2,-0.61),(-8.1,-5.66)]),
    folded([(0,0),(0,-6.26),(-8,-11.48)], 1.5pt),
    seal_curve((0,-6.26),(1.2,-8.7),(4.5,-10.55),(7.5,-11.13)),
    folded([(7.3,-0.52),(7.4,-5.39)])
])

export fire_right := compound([
    folded([(-7.6,-0.52),(-7.7,-5.48)]),
    folded([(0,0),(0,-6.26),(-7.7,-11.22)], 1.4pt),
    seal_curve((0,-6.26),(1.45,-8.8),(5.8,-10.9),(8.8,-11.22)),
    folded([(8.3,-0.43),(8.3,-5.48)])
])

// 冖依參照圖中線取形，弧頂偏左，右肩略低。
export cover := (
    (in_points((-13.86,-19.56)) -- in_points((-13.76,-6.58)))
    & seal_curve((-13.76,-6.58),(-13.78,-5.64),(-13.95,-4.94),(-13.88,-4.23))
    & seal_curve((-13.88,-4.23),(-13.81,-2.75),(-12.98,-2),(-11.76,-1.65))
    & seal_curve((-11.76,-1.65),(-8.99,-0.52),(-4.47,0.02),(0,0))
    & seal_curve((0,0),(3.64,0),(9.47,-0.59),(14.11,-0.71))
    & seal_curve((14.11,-0.71),(16.46,-0.78),(19.04,-1.22),(20.93,-1.95))
    & seal_curve((20.93,-1.95),(23.11,-2.52),(24.64,-3.06),(24.64,-5.08))
    & (in_points((24.64,-5.08)) -- in_points((24.74,-19.86)))
)

export xun := compound([
    folded([(0,0),(0.1,5.17),(-3.9,8.93),(-3.9,14.85),
            (8.6,14.85),(8.6,11.61),(5.6,10.54),(5.7,8.93),(12.1,8.93)], 1.1pt),
    folded([(-10.2,4.66),(14.9,4.86)])
])

// 鴉。牙、鳥各自以接底框的豎腳定位。座標是參照印上的像素位移，向上為正。
// 原圖兩腳在 (415,553)、(449,553)，同一比例換算為印面長度。
fn crow_curve(a:vec2,b:vec2,c:vec2,d:vec2) -> path
    unit_size := 0.223pt
    return bezier(a*unit_size,b*unit_size,c*unit_size,d*unit_size)
end

export tooth := compound([
    crow_curve((-43,223),(-40,214),(-37,207),(-37,198))
        & crow_curve((-37,198),(-38,175),(-41,152),(-40,133))
        & crow_curve((-40,133),(-40,123),(-35,122),(-25,124))
        & crow_curve((-25,124),(-15,125),(-7,126),(1,126)),
    crow_curve((-37,198),(-23,199),(-4,203),(10,201)),
    crow_curve((-40,159),(-27,162),(-14,162),(-5,161))
        & crow_curve((-5,161),(2,161),(4,159),(4,151))
        & crow_curve((4,151),(4,130),(0,112),(0,91))
        & crow_curve((0,91),(-1,57),(0,20),(0,0)),
    crow_curve((0,92),(-16,93),(-31,91),(-37,73))
        & crow_curve((-37,73),(-42,56),(-46,36),(-48,19))
])

export bird := compound([
    crow_curve((35,227),(37,221),(39,213),(39,206)),
    crow_curve((-15,174),(-4,193),(15,200),(36,206))
        & crow_curve((36,206),(51,208),(68,204),(71,192))
        & crow_curve((71,192),(75,179),(64,173),(52,173))
        & crow_curve((52,173),(35,172),(19,171),(12,157))
        & crow_curve((12,157),(5,145),(2,122),(1,93))
        & crow_curve((1,93),(-1,63),(0,26),(0,0)),
    crow_curve((0,159),(25,158),(59,147),(79,143)),
    crow_curve((44,150),(44,119),(43,76),(42,49)),
    crow_curve((5,128),(25,127),(56,116),(79,112)),
    crow_curve((1,93),(23,92),(59,82),(79,78)),
    crow_curve((1,56),(23,54),(59,45),(80,42))
])

// 梓。依吳讓之「張文梓印」左下字轉寫為朱文，木以頂框接點定位。
// 《中國篆刻叢刊・吳讓之》卷二頁47。印面 https://www.sohu.com/a/736651152_121124388
export wood := compound([
    seal_curve((0,0),(-0.45,-15),(0.5,-32),(-0.15,-50.2)),
    seal_curve((-7.25,-4.7),(-7,-16),(-8.8,-22),(-0.05,-24)),
    seal_curve((6.6,-5.25),(6.7,-16.8),(8.25,-21.45),(-0.05,-24)),
    seal_curve((-0.05,-24),(-7.6,-26.5),(-6.55,-35.5),(-7.3,-48.7)),
    seal_curve((-0.05,-24),(7.15,-26.15),(6.5,-36),(6.8,-49.8))
])

export xin := compound([
    seal_curve((-9.3,-0.5),(-4,0.35),(4.5,0.3),(9.2,0)),
    seal_curve((-9.45,-7.55),(-4.8,-7.1),(5.9,-7.05),(10,-7.2)),
    seal_curve((-4.05,-7.45),(-4.1,-16.8),(-4.4,-21.5),(0.35,-24.1))
        & seal_curve((0.35,-24.1),(4.8,-21.35),(4.2,-15.5),(4.4,-7.15)),
    seal_curve((-9.6,-15.2),(-9.6,-25.6),(-8,-30.5),(0.35,-31.9))
        & seal_curve((0.35,-31.9),(8.75,-30.3),(10.05,-23.4),(9.85,-14.6)),
    seal_curve((0.35,-24.1),(0.1,-32.5),(0.6,-38.6),(0.25,-45.35)),
    seal_curve((-9.3,-40.35),(-3.6,-39.75),(5.65,-40.05),(9.75,-39.4))
])

// 行。上肩取漢印相背的兩旁，下腳依本印章法向左右分出。
export step_left := compound([
    seal_curve((-13.85,31.2),(-8.1,30.5),(-2.05,30.05),(0.15,33.1)),
    seal_curve((-13.35,25.6),(-8.9,26.15),(-0.15,27.6),(0,23.25))
        & seal_curve((0,23.25),(-0.1,16.5),(0.4,11.2),(-3.25,7.2))
        & seal_curve((-3.25,7.2),(-7.4,2.65),(-14.2,1.15),(-18.8,0.1))
])

export step_right := compound([
    seal_curve((-0.4,32.65),(1.1,29.45),(7.2,30.3),(13.85,30.1)),
    seal_curve((14,25.1),(9.7,25.65),(1.25,26.7),(0.3,23.35))
        & seal_curve((0.3,23.35),(-0.6,20.17),(-0.55,11.3),(2.55,6.9))
        & seal_curve((2.55,6.9),(5.25,3.07),(10.2,1.2),(14.1,0.45))
])
