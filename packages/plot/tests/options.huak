// Figure and layer options: margins, cropping to drawn content, annotation
// alignment and legend samples.
import assertions.assert
import math.abs
import color.rgb
import object.bounds
import "../plot.huak".*
import "../plot/render.huak" as renderer

BARE := {"xticks": [], "yticks": [], "labels_visible": false, "ticks_visible": false, "grid": false, "spines": [], "xlim": [0, 1], "ylim": [0, 1]}

fn note(align:string, figure_options:dict) -> picture
    fig := figure(200pt, 200pt, figure_options)
    ax := axis of fig at (0, 0)
    plotting ax do
        settings BARE
        +annotate(0.5, 0.5, typ[note]) styled {"align": align}
    end
    return render fig
end

// Alignment pins the text's left edge, center or right edge to the anchor.
plain := {"background": false}
left := bounds(note("left", plain))
center := bounds(note("center", plain))
right := bounds(note("right", plain))
anchor := (center[0].x+center[1].x)/2
assert(abs(left[0].x-anchor) < 0.01pt and abs(right[1].x-anchor) < 0.01pt, "annotation align must pin the matching text edge")
assert(left[1].x > anchor+5pt and right[0].x < anchor-5pt, "aligned text must extend away from its anchor")

// With part, alignment applies to the labeled element of the text instead of
// to the whole text: its center, or with align its left edge, sits on the anchor.
fn note_part(options:dict) -> picture
    fig := figure(200pt, 200pt, plain)
    ax := axis of fig at (0, 0)
    plotting ax do
        settings BARE
        +annotate(0.5, 0.5, typ[peak at #box[$x_0$] <x> here]) styled options
    end
    return render fig
end
body := typ[peak at #box[$x_0$] <x> here]
part_box := body.anchors["x"]
text_box := bounds(object(body))
middle := ((center[0].y+center[1].y)/2)
target := (anchor, middle)
for case in [[{"part": "x"}, part_box.center], [{"part": "x", "align": "left"}, (part_box.min.x, part_box.center.y)]] do
    options:dict := case[0]
    origin:vec2 := case[1]
    placed := bounds(note_part(options))
    expected := text_box[0]+target-origin
    assert(abs(placed[0].x-expected.x) < 0.01pt and abs(placed[0].y-expected.y) < 0.01pt, "a part must sit on the annotation anchor")
end

// A figure keeps its canvas unless auto_bounds crops it to the drawn content.
fixed := note("center", plain)
assert(fixed.width == 200pt and fixed.height == 200pt, "a figure keeps its canvas by default")
cropped := note("center", {"background": false, "auto_bounds": true})
assert(cropped.width < 50pt and cropped.height < 30pt, "auto_bounds must crop to the drawn content")

// The margin insets every panel on each side; the default is no margin.
fn panel(options:dict) -> any
    fig := figure(200pt, 200pt, options)
    ax := axis of fig at (0, 0)
    plotting ax do
        settings BARE
        +lines x [0, 1] y [0, 1]
    end
    panels := renderer.prepare(fig)
    renderer.layout(fig, panels)
    return panels[0]
end
flush := panel({})
inset := panel({"margin": 20pt})
assert(abs(inset.origin.x-flush.origin.x-20pt) < 0.001pt and abs(flush.size.x-inset.size.x-40pt) < 0.001pt, "margin must inset panels on every side")

// legend_line=false keeps an entry's label but drops its line sample. The
// acceptance driver counts each series color in both exports.
fn legend(sample:bool) -> picture
    fig := figure(200pt, 160pt, {"background": false})
    ax := axis of fig at (0, 0)
    plotting ax do
        settings {"legend": "top-left"}
        +lines([0, 1], [0, 1]) styled {"color": rgb(1, 0, 0), "label": typ[line], "legend_line": sample}
        +errorbars([0.5], [0.5], [0.1]) styled {"color": rgb(0, 0, 1), "label": typ[error], "legend_line": sample}
    end
    return render fig
end
export legend_sample := legend(true)
export legend_bare := legend(false)

// title_align anchors the title at the plot area's left edge, center or right
// edge, at the same height.
fn titled(align:string) -> list
    fig := figure(200pt, 200pt, {"background": false})
    ax := axis of fig at (0, 0)
    plotting ax do
        settings BARE
        title typ[Panel title]
        settings {"title_align": align}
    end
    panels := renderer.prepare(fig)
    renderer.layout(fig, panels)
    area := panels[0]
    return [bounds(render fig), area.origin.x, area.origin.x+area.size.x]
end
for align in ["left", "center", "right"] do
    found := titled(align)
    box := found[0]
    if align == "left" then assert(abs(box[0].x-found[1]) < 0.01pt, "a left title starts at the plot area's left edge") end
    if align == "center" then assert(abs((box[0].x+box[1].x)/2-(found[1]+found[2])/2) < 0.01pt, "a centered title is centered over the plot area") end
    if align == "right" then assert(abs(box[1].x-found[2]) < 0.01pt, "a right title ends at the plot area's right edge") end
    assert(abs(box[1].y-titled("center")[0][1].y) < 0.01pt, "alignment keeps the title's height")
end

// tick_style applies the style member of a caller's typ.module around the
// tick text plot typesets.
// Side options override axis options, which override figure options.
mono := typ.module[#let style(body) = { set text(font: "DejaVu Sans Mono"); body }]
serif := typ.module[#let style(body) = { set text(font: "Libertinus Serif"); body }]
fn ticks(figure_options:dict, axis_options:dict, bottom:dict) -> list
    fig := figure(240pt, 200pt, figure_options)
    ax := axis of fig at (0, 0)
    plotting ax do
        settings {"xticks": [0, 0.5, 1], "yticks": [0, 0.5, 1], "xlim": [0, 1], "ylim": [0, 1]}
        settings axis_options
        side "bottom" with bottom
        +heatmap [[1, 2], [3, 4]]
        colorbar "right"
    end
    panels := renderer.prepare(fig)
    renderer.layout(fig, panels)
    found := panels[0]
    return [found.rulers_by_side["bottom"].bodies[1].width, found.rulers_by_side["left"].bodies[1].width, found.color_labels[0].width]
end
unstyled := ticks({}, {}, {})
whole := ticks({"tick_style": mono}, {}, {})
for i in 0:2 do assert(abs(whole[i]-unstyled[i]) > 0.1pt, "a figure tick style must reach every ruler and the colorbar") end
on_axis := ticks({}, {"tick_style": mono}, {})
for i in 0:2 do assert(abs(on_axis[i]-whole[i]) < 0.001pt, "an axis tick style must apply like a figure one") end
on_side := ticks({"tick_style": mono}, {}, {"tick_style": serif})
assert(abs(on_side[0]-unstyled[0]) < 0.001pt and abs(on_side[1]-whole[1]) < 0.001pt, "a side tick style must override the figure's")
print("plot option checks passed")
