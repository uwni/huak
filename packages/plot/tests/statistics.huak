import assertions.assert
import "../plot.huak".*
import "../plot/statistics.huak" as stats
import "../plot/render.huak" as renderer
import "../plot/scales.huak" as scales

values := stats.sorted([4, false, 1, 3, 2])
assert(values[0] == 1 and values[3] == 4)
assert(stats.quantile(values, 0.25) == 1.75)
assert(stats.quantile(values, 0.5) == 2.5)
assert(stats.quantile(values, 0.75) == 3.25)
histogram := stats.histogram([0, 1, 2, 3, 4], edges: [0, 2, 4])
assert(histogram["values"][0] == 2 and histogram["values"][1] == 3)
density := stats.histogram([0, 1, 2, 3, 4], normalization: "density", edges: [0, 1, 4])
assert(math.abs(density["values"][0]+3*density["values"][1]-1) < 1e-12)
assert(stats.histogram([], bins: 2)["included"] == 0)
assert(stats.histogram([5, 5, 5], bins: 2)["included"] == 3)
assert(stats.histogram([1e100, 1e100], bins: 2)["included"] == 2)
collision := stats.prepare([bar(["c"], [2], {"stack": "a:b"}), bar(["b:c"], [3], {"stack": "a"})], {})
assert(collision[1].y[0] == 0)
fig := figure with width 400pt height 300pt
a := axis of fig at (0, 0)
b := axis of fig at (1, 0)
plotting a do
    +bar categories ["A", "B"] values [2, -3] styled {"stack": "s"}
    +bar categories ["A", "B"] values [4, -5] styled {"stack": "s"}
end
plotting b do
    +bar categories ["B", "C"] values [1, 2]
end
link_x of fig axes [a, b]
panels := renderer.prepare(fig)
assert(panels[0].layers[1].y[0] == 2)
assert(panels[0].layers[1].data["y1"][0] == 6)
assert(panels[0].layers[1].data["y1"][1] == -8)
assert(len(panels[0].x.categories) == 3 and len(panels[1].x.categories) == 3)
assert(scales.coordinate(panels[0].x, "B") == scales.coordinate(panels[1].x, "B"))
box := stats.prepare([boxplot(["A"], [[1, 2, 3, 4, 5, 12]])], {})
assert(box[0].y[0] == 2.25 and box[0].data["y1"][0] == 4.75)
assert(len(box[2].y) == 1 and box[2].y[0] == 12)
print("plot statistics checks passed")
