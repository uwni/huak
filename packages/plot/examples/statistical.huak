import "../plot.huak".*
fig := figure with width 20cm height 16cm
a := axis of fig at (0, 0)
b := axis of fig at (0, 1)
c := axis of fig at (1, 0)
d := axis of fig at (1, 1)
e := axis of fig at (2, 0)
f := axis of fig at (2, 1)
plotting a do
    title typ[Grouped bars]
    +bar categories ["A", "B", "C"] values [2, 4, 3] styled {"group": "g"} named typ[First]
    +bar categories ["A", "B", "C"] values [3, 2, 5] styled {"group": "g"} named typ[Second]
    legend "top-left"
end
plotting b do
    title typ[Histogram]
    +hist [-2, -1.5, -1, -0.7, -0.3, 0, 0.1, 0.2, 0.4, 0.5, 0.7, 1, 1.2, 1.7, 2]
end
plotting c do
    title typ[Asymmetric errors]
    +errorbars x [0, 1, 2, 3] y [1, 3, 2, 4] errors [0.2, 0.5, 0.3, 0.4] styled {"upper": [0.5, 0.2, 0.7, 0.8]} marked (marker "circle" sized 4pt)
end
plotting d do
    title typ[Band and line]
    +band x [0, 1, 2, 3] lower [0, 1, 0.5, 2] upper [1, 2, 1.5, 3] styled {"fill": color.rgb(0.2, 0.5, 0.8, 0.25)}
    +lines x [0, 1, 2, 3] y [0.5, 1.5, 1, 2.5]
end
plotting e do
    title typ[Box plots]
    +boxplot categories ["A", "B", "C"] samples [[1, 2, 3, 4, 5, 12], [2, 3, 4, 5, 6], [1, 1, 2, 2, 3, 4]] styled {"fill": color.rgb(0.2, 0.5, 0.8, 0.25), "pen": pen(color.rgb(0, 0.4, 0.6), 0.8pt)}
end
plotting f do
    title typ[Horizontal stacked bars]
    +bar categories ["A", "B"] values [2, -3] styled {"stack": "s", "orientation": "horizontal"}
    +bar categories ["A", "B"] values [3, -2] styled {"stack": "s", "orientation": "horizontal"}
end
default render fig
