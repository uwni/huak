// Independent plotting package. Call forms are ordinary exported mixfix roles.
import "plot/model.huak".{Figure, Axis, Layer, Marker, figure, axis, lines, scatter, styled, named, marked, sized, configure, insert, link_x, link_y, side, remap, on_axes, arrow, arrowed, breaks}
import "plot/markers.huak".{marker, custom_marker}
import "plot/render.huak".render
import "plot/statistics.huak".{bar, hist, errorbars, band, area, boxplot, hline, vline, annotate}
import "plot/heatmap.huak".{heatmap, colormap}
export heatmap, colormap
export side, remap, on_axes, arrow, arrowed, breaks
export bar, hist, errorbars, band, area, boxplot, hline, vline, annotate
export Figure, Axis, Layer, Marker, figure, axis, lines, scatter, styled, named, marked, sized, configure, insert, link_x, link_y, marker, custom_marker, render

precedence attributes
    below logical_or
    associativity left
end
precedence insertion
    below attributes
end
mixfix(figure) figure with width _ height _ in unary
mixfix(axis) axis of _ at _ in unary
mixfix(lines) lines x _ y _ in unary
mixfix(scatter) scatter x _ y _ in unary
mixfix(bar) bar categories _ values _ in unary
mixfix(hist) hist _ in unary
mixfix(heatmap) heatmap _ in unary
mixfix(colormap) colormap _ in unary
mixfix(errorbars) errorbars x _ y _ errors _ in unary
mixfix(band) band x _ lower _ upper _ in unary
mixfix(area) area x _ y _ in unary
mixfix(boxplot) boxplot categories _ samples _ in unary
mixfix(hline) hline _ in unary
mixfix(vline) vline _ in unary
mixfix(annotate) annotate _ at _ text _ in unary
mixfix(marker) marker _ in unary
mixfix(custom_marker) custom_marker _ in unary
mixfix(styled) _ styled _ in attributes
mixfix(named) _ named _ in attributes
mixfix(marked) _ marked _ in attributes
mixfix(sized) _ sized _ in attributes
mixfix(on_axes) _ on_axes x _ y _ in attributes
mixfix(arrow) arrow from _ to _ in unary
mixfix(arrowed) _ arrowed _ in attributes
mixfix(render) render _ in unary
mixfix(link_x) link_x of _ axes _ in unary
mixfix(link_y) link_y of _ axes _ in unary

fn set_title(target:Axis, value:text); configure(target, {"title": value}); end
fn set_xlabel(target:Axis, value:text); configure(target, {"xlabel": value}); end
fn set_ylabel(target:Axis, value:text); configure(target, {"ylabel": value}); end
fn set_xscale(target:Axis, value:string); configure(target, {"xscale": value}); end
fn set_yscale(target:Axis, value:string); configure(target, {"yscale": value}); end
fn set_xlim(target:Axis, value:list); configure(target, {"xlim": value}); end
fn set_ylim(target:Axis, value:list); configure(target, {"ylim": value}); end
fn set_legend(target:Axis, value:string); configure(target, {"legend": value}); end
fn set_colorbar(target:Axis, value:string); configure(target, {"colorbar": value}); end

export expand_block plotting(target:Axis)
    add := insert.with(target: target)
    settings := configure.with(ax: target)
    side := side.with(ax: target)
    remap := remap.with(ax: target)
    breaks := breaks.with(ax: target)
    title := set_title.with(target: target)
    xlabel := set_xlabel.with(target: target)
    ylabel := set_ylabel.with(target: target)
    xscale := set_xscale.with(target: target)
    yscale := set_yscale.with(target: target)
    xlim := set_xlim.with(target: target)
    ylim := set_ylim.with(target: target)
    legend := set_legend.with(target: target)
    colorbar := set_colorbar.with(target: target)
    mixfix(add) + _ in insertion
    mixfix(settings) settings _ in logical_or
    mixfix(side) side _ with _ in logical_or
    mixfix(remap) remap _ ticks _ to _ in logical_or
    mixfix(breaks) breaks _ over _ gap _ in logical_or
    mixfix(title) title _ in logical_or
    mixfix(xlabel) xlabel _ in logical_or
    mixfix(ylabel) ylabel _ in logical_or
    mixfix(xscale) xscale _ in logical_or
    mixfix(yscale) yscale _ in logical_or
    mixfix(xlim) xlim _ in logical_or
    mixfix(ylim) ylim _ in logical_or
    mixfix(legend) legend _ in logical_or
    mixfix(colorbar) colorbar _ in logical_or
    ...
    return target
end
