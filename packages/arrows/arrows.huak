// Arrowheads and other marks at the ends of lines and partway along them,
// after Typst's tiptoe package: a mark is a function of the line it ends,
// and one call draws the line with all its marks.
import "arrows/model.huak".{Line, Piece, Mark, Along, along, combine, gap, rigid, inked}
import "arrows/heads.huak".{stealth, triangle, round, straight, barb, hooks, tikz}
import "arrows/symbols.huak".{bar, bracket, disk, square, diamond, rays}
import "arrows/line.huak".{line, glyph}
export Line, Piece, Mark, Along, along, combine, gap, rigid, inked
export stealth, triangle, round, straight, barb, hooks, tikz
export bar, bracket, disk, square, diamond, rays
export line, glyph
